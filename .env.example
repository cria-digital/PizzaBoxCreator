# =============================================================
# Pizza Box Agent — configuracao
# Copie para .env e preencha. O .env NUNCA vai pro git.
#   cp .env.example .env
# =============================================================

# -------------------------------------------------------------
# 1. IA  (OBRIGATORIO — sem isso o parser de mensagens, a analise
#    de foto e o preview de aprovacao nao funcionam)
# -------------------------------------------------------------
# AI_PROVIDER: "auto" usa a chave que estiver preenchida (Claude tem preferencia),
# ou force "anthropic" / "gemini" / "ollama".
# ATENCAO: o preview de aprovacao por IA (/ai-preview) SO funciona com Gemini,
# porque e o unico provider de imagem implementado. Se voce for usar esse recurso,
# preencha GEMINI_API_KEY mesmo que use Claude para texto.
AI_PROVIDER=auto

# Claude (texto + visao). Modelos usados: claude-haiku-4-5
# Chave em: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gemini (texto + visao + geracao de imagem). Requer o extra: pip install -e .[gemini]
# Modelos usados: gemini-2.5-flash (texto/visao) e GEMINI_IMAGE_MODEL (imagem)
# Chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de geracao de imagem do preview de aprovacao ("Nano Banana").
# Cada chamada a /ai-preview e uma geracao PAGA.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
AI_PREVIEW_ASPECT_RATIO=16:9
# Imagem de referencia de layout de caixa planificada (opcional; vazio = so texto).
AI_PREVIEW_REFERENCE=assets/box_layout_reference.jpg

# Ollama/Llama local ou self-hosted (texto apenas). Para testar sem custo de API:
#   ollama serve
#   ollama pull llama3.2:3b
#   AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# -------------------------------------------------------------
# 1b. Controle de custo de IA (PREVENCao de gastos descontrolados)
# -------------------------------------------------------------
# Maximo de previews por pedido dentro da janela de tempo (prevenir loops de ajuste).
AI_PREVIEW_MAX_PER_ORDER=5
# Janela de tempo em horas para o limite acima (rolling window).
AI_PREVIEW_RATE_WINDOW_HOURS=24
# Cache: se o pedido for re-gerado com os mesmos dados, reutiliza o preview anterior.
AI_PREVIEW_CACHE_ENABLED=true
# Tempo de vida do cache em horas.
AI_PREVIEW_CACHE_TTL_HOURS=24

# -------------------------------------------------------------
# 2. Acesso ao painel web (OBRIGATORIO — nao tem default)
# -------------------------------------------------------------
ADMIN_USER=admin
# Minimo recomendado: 12 caracteres (abaixo disso o app so loga um aviso no boot).
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Assina o cookie de sessao. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
# true exige HTTPS para o cookie de sessao — ative em producao com TLS.
SECURE_COOKIES=false

# -------------------------------------------------------------
# 3. Producao grafica
# -------------------------------------------------------------
# DPI gravado no PSD CMYK de producao. Gabaritos costumam vir em 72 DPI;
# a grafica precisa de 300 ou 350.
PRODUCTION_DPI=350
# Remocao automatica de fundo da logo do cliente (requer: pip install -e .[logo]).
# Sem a lib instalada, a logo e usada como veio.
LOGO_REMOVE_BACKGROUND=true

# -------------------------------------------------------------
# 4. Banco de dados
# -------------------------------------------------------------
DATABASE_URL=postgresql://pizzabox:pizzabox_secret@localhost:5432/pizzabox

# -------------------------------------------------------------
# 5. Pastas e servidor (defaults funcionam; mude so se precisar)
# -------------------------------------------------------------
TEMPLATES_DIR=gabaritos
OUTPUT_DIR=storage/output
ART_MASTERS_DIR=storage/art_masters
PREVIEW_DIR=storage/preview
BACKUPS_DIR=storage/backups
LOGS_DIR=storage/logs
TEMP_DIR=temp
THUMBNAILS_DIR=storage/thumbnails
LOGOS_DIR=storage/logos
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Origens permitidas no CORS (separadas por virgula). "*" e ok em dev;
# defina origens explicitas antes de expor o app (ex: https://admin.suaempresa.com).
CORS_ORIGINS=*

# -------------------------------------------------------------
# 6. Gerenciamento de armazenamento
# -------------------------------------------------------------
# O dashboard e /api/storage disparam alertas em 80% e 90% por padrao.
STORAGE_WARNING_THRESHOLD_PERCENT=80
STORAGE_CRITICAL_THRESHOLD_PERCENT=90
# Para cron/scheduled job, deixe true quando quiser permitir execucao automatica real.
STORAGE_CLEANUP_ENABLED=false
# Dry-run true e o padrao seguro para automacoes novas.
STORAGE_CLEANUP_DRY_RUN=true
STORAGE_RETENTION_DELIVERED_DAYS=30
STORAGE_RETENTION_TEMP_HOURS=24
STORAGE_BACKUP_MAX_FILES=30
STORAGE_ALERT_COOLDOWN_HOURS=24

# -------------------------------------------------------------
# 7. WhatsApp Business API (Meta) — OPCIONAL
#    Deixe em branco para manter a integracao desligada.
#    Como obter: developers.facebook.com -> criar App -> produto "WhatsApp"
#      META_PHONE_NUMBER_ID / META_WHATSAPP_TOKEN: painel do produto WhatsApp
#      META_APP_SECRET: Configuracoes do App -> Basico
#      META_WEBHOOK_VERIFY_TOKEN: string que voce escolhe e repete na config do Webhook
#    Webhook do App deve apontar para:
#      https://<seu-host>/api/webhooks/whatsapp   (precisa de HTTPS publico; use ngrok em dev)
#    Alternativa: da pra configurar tudo isso pela tela /configuracoes/whatsapp,
#    sem reiniciar o app (fica salvo no banco e tem precedencia sobre estas variaveis).
# -------------------------------------------------------------
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# Meta API version
META_API_VERSION=v21.0
