# =============================================================
# Pizza Box Agent — .gitignore
# Regra geral: versiona CODIGO. Arte pesada, dados de runtime e
# segredos ficam de fora (ver README.md > "O que nao esta no repo").
# =============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# ---- Testes / cobertura ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Segredos e config local (NUNCA commitar) ----
.env
.env.local
.env.*.local
.claude/settings.local.json

# ---- Logs ----
*.log

# ---- Dados gerados em runtime ----
# Todas essas pastas sao recriadas no boot por config.ensure_dirs().
storage/output/
storage/preview/
storage/thumbnails/
storage/logos/
temp/
*.db
*.db-wal
*.db-shm

# ---- Arte pesada (entregue fora do git) ----
assets/originais/

# PSD/PSB nao vao pro repo por padrao (arquivos de 20-500 MB)...
*.psd
*.psb
# ...exceto estes tres gabaritos leves, necessarios pra rodar e testar o sistema:
!gabaritos/caixa_35cm_teste.psd
!gabaritos/caixa_producao_placeholder.psd
!gabaritos/cod_eg03_premium.psd

# ---- Arquivos de trabalho soltos na raiz (facas em PDF, prints de WhatsApp) ----
*.pdf
WhatsApp Image*
WhatsApp Video*

# ---- SO / editores ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
